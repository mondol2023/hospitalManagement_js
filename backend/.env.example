# ---------------------------------------------------------------------------
# Copy to .env and fill in. Validated by src/config/env.js at boot: anything
# missing or malformed stops the process immediately with a listed reason.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Persistence -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/hospital
# Sized for ~10k users behind N app processes. Keep
# (MONGO_MAX_POOL_SIZE x processes) below the server's connection limit.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# --- Cache / pub-sub -------------------------------------------------------
# Optional in development: without it the app degrades to in-process caching,
# in-memory rate limiting and a single-node socket layer. Required in production.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=60

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters each, and they MUST differ in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=hospital-management-api
BCRYPT_ROUNDS=12

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Enable only when genuinely behind a proxy/load balancer, otherwise clients can
# spoof X-Forwarded-For and evade rate limiting.
TRUST_PROXY=false
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Runtime ---------------------------------------------------------------
# One process per core. Leave false when an external supervisor (pm2, k8s)
# already runs multiple replicas.
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=info

# --- Optional integrations (providers no-op while unset) -------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@hospital.local
SMS_PROVIDER_URL=
SMS_API_KEY=
STRIPE_SECRET_KEY=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_BYTES=5242880
