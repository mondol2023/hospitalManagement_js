{
  "root": true,
  "env": {
    "node": true,
    "es2023": true
  },
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "smart"],
    "no-return-await": "error",
    "require-atomic-updates": "off",
    "strict": ["error", "global"]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": { "jest": true },
      "rules": {
        "no-unused-vars": [
          "error",
          { "args": "after-used", "argsIgnorePattern": "^_", "ignoreRestSiblings": true }
        ]
      }
    }
  ]
}
