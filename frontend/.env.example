# Copy to .env.local. Everything here is baked into the client bundle at build
# time and is therefore PUBLIC — never put a secret in a VITE_* variable.

# Backend API root. Must include the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Socket.io origin (the server root, not the /api/v1 prefix).
VITE_SOCKET_URL=http://localhost:5000
